# =============================================
# Projeto Olho Vivo - Variáveis de Ambiente
# =============================================

# PostgreSQL
POSTGRES_DB=olhovivo
POSTGRES_USER=olhovivo
POSTGRES_PASSWORD=CHANGE_ME_IN_PRODUCTION
DATABASE_URL=postgresql://olhovivo:CHANGE_ME_IN_PRODUCTION@postgres:5432/olhovivo

# JWT
SECRET_KEY=CHANGE_ME_GENERATE_A_RANDOM_KEY
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=http://localhost:5173,http://192.168.3.12:5173

# Redis
REDIS_URL=redis://redis:6379/0

# Vision — DVR Intelbras Filial 28
# Altere SENHA_DO_DVR pela senha real do seu equipamento Intelbras
VIDEO_SOURCE=rtsp://admin:SENHA_DO_DVR@192.168.1.3:554/cam/realmonitor?channel=1&subtype=1
VISION_OUTPUT_DIR=/app/output
BACKEND_URL=http://backend:8000
FILIAL_ID=RIUAL_028
CAMERA_ID=CAM01

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
